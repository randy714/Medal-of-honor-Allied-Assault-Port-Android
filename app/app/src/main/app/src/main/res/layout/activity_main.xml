<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GDROID"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MEDAL OF HONOR // ALLIED ASSAULT RUNTIME"
            android:textColor="#3D79F2"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161616"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="READY"
                android:textColor="#4CAF50"
                android:textSize="10sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready to play (Medal of Honor: AA)"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:paddingBottom="12dp"/>

            <Button
                android:id="@+id/btnLaunch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#2D7FF9"
                android:text="PLAY MEDAL OF HONOR"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="■ SETTINGS &amp; TOOLS"
            android:textColor="#3D79F2"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Play from a folder (Game Directory)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/edtGamePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="/storage/emulated/0/MOHAA"
            android:textColor="#888888"
            android:textSize="12sp"
            android:background="@android:color/transparent"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Target FPS Limit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingTop="8dp"/>
        <Spinner
            android:id="@+id/spinnerFps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Graphics Renderer API"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingTop="8dp"/>
        <Spinner
            android:id="@+id/spinnerRenderer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
          
